<% layout('./layout', {
  title: `Reports - ${it.APP_NAME} Admin`,
  noindex: true,
  scripts: ['js/common.js', 'js/admin-reports.js']
}) %>
  <main class="admin">
    <h1>Reports</h1>
    <p>There are <%= it.reports.length %> report(s).</p>
<% for (const report of it.reports) { %>
    <div class="admin-report" data-project-id="<%= report.projectId %>">
      <h2><a href="<%= it.PUBLIC_URL %>/projects/<%= report.projectId %>" target="_blank"><%= report.projectTitle %></a> <%= report.reportId %></h2>
      <p>Project description:</p>
      <textarea readonly autocomplete="off">
<%= report.projectDescription %></textarea>
      <p>Report description:</p>
      <textarea readonly autocomplete="off">
<%= report.reportBody %></textarea>
      <p>
        <button class="dismiss-report" data-report-id="<%= report.reportId %>">Dismiss report</button>
        <button class="ignore-reports">Dismiss and ignore future reports for project</button>
        <button class="delete-project">Delete project</button>
      </p>
    </div>
<% } %>
  </main>
